# Database
DATABASE_URL=postgres://user:pass@localhost:5432/zarg

# Auth
AUTH_SECRET=replace-with-32-byte-random-string
AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM="Zarg <onboarding@yourdomain.com>"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DISCOVERY_MODEL=claude-opus-4-7
ANTHROPIC_BRIEFING_MODEL=claude-sonnet-4-6

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=ZargBot

# App
APP_URL=http://localhost:3000
